{
    "name": "transperfect/globallink-connect-php",
    "description": "PHP SDK for the GlobalLink Enterprise REST API",
    "type": "library",
    "license": "proprietary",
    "keywords": ["globallink", "translation", "localization", "i18n", "transperfect"],
    "homepage": "https://www.transperfect.com/globallink",
    "authors": [
        {
            "name": "TransPerfect GlobalLink",
            "homepage": "https://www.transperfect.com/globallink"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "GlobalLink\\RestClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlobalLink\\RestClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
