# GlobalLink API Configuration
#
# Copy this file to .env and fill in your credentials.
# Never commit .env files to version control!

# Base URL of your GlobalLink instance
GLE_API_URL=https://your-instance.globallink.com

# Your GlobalLink username
GLE_USERNAME=your-username

# Your GlobalLink password
GLE_PASSWORD=your-password

# OAuth client ID (provided by TransPerfect)
GLE_OAUTH_CLIENT=your-oauth-client-id

# OAuth client secret (provided by TransPerfect)
GLE_OAUTH_SECRET=your-oauth-client-secret
