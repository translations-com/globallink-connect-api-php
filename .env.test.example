# GlobalLink Test Configuration
#
# Copy this file to .env.test and fill in your sandbox/test credentials.
# These credentials are used by integration tests.
# Never commit .env.test files to version control!

# ==============================================================================
# Required Configuration
# ==============================================================================

# Base URL of your GlobalLink test/sandbox instance
GLE_TEST_API_URL=https://sandbox.globallink.com

# Test username
GLE_TEST_USERNAME=test-user

# Test password
GLE_TEST_PASSWORD=test-password

# OAuth client ID for testing
GLE_TEST_OAUTH_CLIENT=test-client-id

# OAuth client secret for testing
GLE_TEST_OAUTH_SECRET=test-client-secret

# ==============================================================================
# Optional Configuration (for submission workflow tests)
# ==============================================================================

# Project ID to use for integration tests
GLE_TEST_PROJECT_ID=1001

# File format name for parsing uploaded files (e.g., "XML", "JSON", "XLIFF")
GLE_FILE_FORMAT_NAME=XML

# Source language code for submissions
GLE_SOURCE_LANGUAGE=en-US

# Target language codes for submissions (comma-separated)
# You can specify any number of target languages
GLE_TARGET_LANGUAGES=de-DE,ja-JP

# Test file name (should exist in tests/Integration/ directory)
GLE_TEST_FILE_NAME=test.xml

# Seconds to wait for new submissions' targets to reach PROCESSED (default 180).
# The project's first workflow should complete automatically (e.g. pseudo-translation).
GLE_TEST_PROCESSING_TIMEOUT=180
